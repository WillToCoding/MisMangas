{
  "sourceLanguage" : "es",
  "strings" : {
    "" : {

    },
    "\"%@\"" : {
      "comment" : "A footer in the filter view that shows the text that was searched for.",
      "isCommentAutoGenerated" : true
    },
    "(%lld)" : {
      "comment" : "A count of how many genres the user has selected in the filter.",
      "isCommentAutoGenerated" : true
    },
    "%.2f" : {
      "comment" : "A star icon with a label showing the manga's score, followed by a separator and the number of volumes.",
      "isCommentAutoGenerated" : true
    },
    "%@" : {
      "comment" : "A message to display when the user's reading progress is empty. The argument is the string \"siri_no_manga_reading\".",
      "isCommentAutoGenerated" : true
    },
    "%@ - %@" : {
      "comment" : "A single line of text displaying the title and progress of a manga. The first argument is the manga title. The second argument is a description of the manga's current reading progress.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ - %2$@"
          }
        }
      }
    },
    "%@ %@" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ %2$@"
          }
        }
      }
    },
    "%lld" : {
      "comment" : "A large, bold text label displaying the number of mangas in the user's collection.",
      "isCommentAutoGenerated" : true
    },
    "••••••••" : {
      "comment" : "A placeholder text for a password field.",
      "isCommentAutoGenerated" : true
    },
    "1,2,3" : {
      "comment" : "A placeholder text for a text field that allows the user to input a list of volumes.",
      "isCommentAutoGenerated" : true
    },
    "1.0.0" : {
      "comment" : "The version of the app.",
      "isCommentAutoGenerated" : true
    },
    "2025.12.11" : {
      "comment" : "The build number of the app.",
      "isCommentAutoGenerated" : true
